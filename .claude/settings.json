{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",

    "deny": [
      "mcp__*",
      "Read(/*.xlsx)",
      "Edit(/*.xlsx)",
      "Read(/*.jpeg)",
      "Edit(/*.jpeg)",
      "Read(/config/app.json)",
      "Edit(/config/app.json)",
      "Read(/data/**)",
      "Edit(/data/**)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git switch -f *)",
      "Bash(git switch --discard-changes *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend *)",
      "Bash(git commit --no-verify *)",
      "Bash(git branch -D *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],

    "ask": [
      "Bash(npm install)",
      "Bash(npm ci)"
    ],

    "allow": [
      "Bash(nvm use)",
      "Bash(npm run verify)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit)",
      "Bash(node --version)",
      "Bash(unzip -l *)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-dados-sensiveis.sh",
            "statusMessage": "Verificando comando contra artefatos sensiveis...",
            "timeout": 15
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/conferir-distribuicao.sh",
            "statusMessage": "Conferindo se a distribuicao ficou para tras...",
            "timeout": 20
          }
        ]
      }
    ],

    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/registrar-instrucoes.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/conferir-alinhamento.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
